# Folders to ignore
node_modules/
.DS_Store
.vscode/
.cursor/
.claude/
.gemini/
# Keep reproducible public-web verification and packaging helpers.
scripts/*
!scripts/verify-*.cjs
!scripts/serve-web.py
!scripts/package-web.py
dist/
build/
# Separate local projects are not part of the web repository or release.
/android/
/mobile-prototype/
# Internal build plans and specs: contain local absolute paths
docs/superpowers/

# IDE files
*.sublime-project
*.sublime-workspace
.idea/

# OS files
Thumbs.db
desktop.ini

# Release archives (keep off Git; attach ZIPs to GitHub Releases instead)
*.zip

# Local working copies of tagged releases (always recoverable via git tag)
AINOW-Literacy-v0.9*/

# Scraps
translate_prompts.py
translate_script.js
translate_script.py
sq_prompts.json
en_prompts.json
data.json


